-- Universal Auto Farm Engine (Level / Chests / Materials / Elite)
task.spawn(function()
    while true do
        task.wait(0.1)
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
            
            -- Teleport Mode
            if _G.Config.IsTeleporting then
                local pos = islandsBySea[_G.Config.SelectedIslandSea][_G.Config.SelectIsland]
                if pos then
                    if (char.HumanoidRootPart.Position - pos).Magnitude > 20 then
                        SmoothMove(CFrame.new(pos + Vector3.new(0, 30, 0)))
                    else
                        _G.Config.IsTeleporting = false
                    end
                end

            -- Auto Chest Farm Mode
            elseif _G.Config.AutoChestFarm then
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj.Name:find("Chest") and obj:IsA("Part") then
                        SmoothMove(obj.CFrame)
                        task.wait(0.2)
                        break
                    end
                end

            -- Auto Material Farm Mode
            elseif _G.Config.AutoMaterial then
                local mobTargetName = materialToMob[_G.Config.SelectMaterial]
                local targetMob = nil
                local enemies = workspace:FindFirstChild("Enemies")

                if enemies then
                    for _, mob in pairs(enemies:GetChildren()) do
                        if mob.Name == mobTargetName and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            targetMob = mob
                            break
                        end
                    end
                end

                if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                    SmoothMove(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 6, 2))
                end

            -- Auto Farm Level Mode
            elseif _G.Config.AutoFarm then
                local enemies = workspace:FindFirstChild("Enemies")
                local targetMob = nil
                if enemies then
                    for _, mob in pairs(enemies:GetChildren()) do
                        if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            targetMob = mob
                            break
                        end
                    end
                end

                if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                    SmoothMove(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 6, 2))
                end
            end
        end
    end
end)

