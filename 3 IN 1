-- 3. إدارة التبويبات وتشغيل السكربتات
-- ==========================================

local tabs = {}

local function CreateScriptTab(tabName, onActivateScript)
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(0.9, 0, 0, 32)
    TabBtn.BackgroundColor3 = Color3.fromRGB(25, 30, 44)
    TabBtn.Text = tabName
    TabBtn.TextColor3 = Color3.fromRGB(150, 160, 180)
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.TextSize = 10
    TabBtn.Parent = Sidebar

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = TabBtn

    local TabPage = Instance.new("ScrollingFrame")
    TabPage.Size = UDim2.new(1, 0, 1, 0)
    TabPage.BackgroundTransparency = 1
    TabPage.Visible = false
    TabPage.ScrollBarThickness = 3
    TabPage.CanvasSize = UDim2.new(0, 0, 0, 0)
    TabPage.Parent = ContentArea

    local PageLayout = Instance.new("UIListLayout")
    PageLayout.Padding = UDim.new(0, 8)
    PageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    PageLayout.Parent = TabPage

    PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabPage.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 20)
    end)

    local executed = false

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            t.Btn.TextColor3 = Color3.fromRGB(150, 160, 180)
            t.Btn.BackgroundColor3 = Color3.fromRGB(25, 30, 44)
        end
        TabPage.Visible = true
        TabBtn.TextColor3 = Color3.fromRGB(0, 210, 255)
        TabBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 70)

        -- تشغيل كود السكربت المخصص لهذه القائمة عند فتحها لأول مرة
        if not executed then
            executed = true
            if onActivateScript then onActivateScript(TabPage) end
        end
    end)

    table.insert(tabs, {Btn = TabBtn, Page = TabPage})
    return TabPage
end

