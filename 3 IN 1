    TabPage.ScrollBarThickness = 3
    TabPage.CanvasSize = UDim2.new(0, 0, 0, 0)

    local PageLayout = Instance.new("UIListLayout", TabPage)
    PageLayout.Padding = UDim.new(0, 5)
    PageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        TabPage.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 10)
    end)

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            t.Btn.TextColor3 = Color3.fromRGB(150, 160, 180)
            t.Btn.BackgroundColor3 = Color3.fromRGB(25, 30, 44)
        end
        TabPage.Visible = true
        TabBtn.TextColor3 = Color3.fromRGB(0, 210, 255)
        TabBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 70)
    end)

    table.insert(tabs, {Btn = TabBtn, Page = TabPage})
    return TabPage
end

local function AddToggle(parentPage, name, configVar, callback)
    local Button = Instance.new("TextButton", parentPage)
    Button.Size = UDim2.new(0.96, 0, 0, 32)
    Button.BackgroundColor3 = Color3.fromRGB(22, 26, 38)
    Button.Text = "  " .. name
    Button.TextColor3 = _G.Config[configVar] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
    Button.Font = Enum.Font.GothamMedium
    Button.TextSize = 9
    Button.TextXAlignment = Enum.TextXAlignment.Left
    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 6)

    local Indicator = Instance.new("Frame", Button)
    Indicator.Size = UDim2.new(0, 26, 0, 14)
    Indicator.Position = UDim2.new(1, -32, 0.5, -7)
    Indicator.BackgroundColor3 = _G.Config[configVar] and Color3.fromRGB(0, 210, 255) or Color3.fromRGB(45, 50, 65)
    Instance.new("UICorner", Indicator).CornerRadius = UDim.new(0, 10)

    Button.MouseButton1Click:Connect(function()
        _G.Config[configVar] = not _G.Config[configVar]
        Indicator.BackgroundColor3 = _G.Config[configVar] and Color3.fromRGB(0, 210, 255) or Color3.fromRGB(45, 50, 65)
        Button.TextColor3 = _G.Config[configVar] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(150, 150, 160)
        if callback then callback(_G.Config[configVar]) end
    end)
    return Button
end

