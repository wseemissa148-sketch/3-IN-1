-- Fast Attack Engine
function FastAttackUniversal()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local targets = {}
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in pairs(enemies:GetChildren()) do
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if (char.HumanoidRootPart.Position - hrp.Position).Magnitude <= 70 then
                    table.insert(targets, hrp)
                end
            end
        end
    end
    if #targets > 0 then
        pcall(function()
            ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterAttack"):FireServer(0.001)
            for _, hitTarget in pairs(targets) do
                local attackId = tostring(math.random(100000, 999999))
                ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterHit"):FireServer(hitTarget, {}, attackId)
            end
        end)
        local equippedTool = char:FindFirstChildOfClass("Tool")
        if equippedTool then equippedTool:Activate() end
    end
end

task.spawn(function()
    while true do
        if _G.Config.FastAttack or _G.Config.TargetPVP then
            FastAttackUniversal()
        end
        task.wait(_G.Config.AttackDelay)
    end
end)

