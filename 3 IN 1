local function GetRealTimeEliteStatus()
    local eliteNames = {"Deandre", "Diablo", "Urban"}
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, name in ipairs(eliteNames) do
            local boss = enemies:FindFirstChild(name)
            if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 then
                return "✅ Spawned: " .. name
            end
        end
    end
    
    local timeAlive = workspace.DistributedGameTime
    local nextSpawn = 600 - (math.floor(timeAlive) % 600)
    local mins = math.floor(nextSpawn / 60)
    local secs = math.floor(nextSpawn % 60)
    return string.format("❌ Spawning in: %02d:%02d", mins, secs)
end

