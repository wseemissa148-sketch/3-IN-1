-- تجميع الصناديق بتأنٍ وبشكل آمن
task.spawn(function()
    while true do
        task.wait(0.1)
        if _G.Config.AutoChestFarm or _G.Config.AutoV3Mink then
            pcall(function()
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                for _, obj in pairs(workspace:GetDescendants()) do
                    if (_G.Config.AutoChestFarm or _G.Config.AutoV3Mink) and obj.Name:find("Chest") and (obj:IsA("Part") or obj:IsA("Model")) then
                        local cf = obj:IsA("Model") and (obj.PrimaryPart and obj.PrimaryPart.CFrame or obj:GetAttribute("CFrame")) or obj.CFrame
                        if cf then
                            TweenTo(cf, _G.Config.ChestSpeed)
                            task.wait(0.5)
                        end
                    end
                end
            end)
        end
    end
end)

-- Anti-AFK
player.Idled:Connect(function()
    if _G.Config.AntiAFK then
        VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
