local function GetFullMoonTimer()
    local moonPhase = Lighting:GetAttribute("MoonPhase") or 0
    if moonPhase == 5 then return " Full Moon Active NOW!" end
    local phasesLeft = 5 - moonPhase
    if phasesLeft < 0 then phasesLeft = phasesLeft + 8 end
    local minutesLeft = math.floor((phasesLeft * 20) + ((24 - Lighting.ClockTime) / 24 * 20))
    if minutesLeft <= 0 then minutesLeft = 1 end
    return " Full Moon in: ~" .. tostring(minutesLeft) .. " Mins (Phase " .. tostring(moonPhase) .. "/5)"
end

local function GetChaliceDropChance()
    local minutes = math.floor(workspace.DistributedGameTime / 60)
    if minutes >= 240 then return "100% (Maximum Chance!)" end
    return tostring(math.clamp(math.floor((minutes / 240) * 100), 1, 99)) .. "% (" .. tostring(240 - minutes) .. "m left)"
end

