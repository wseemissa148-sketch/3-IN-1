local function FastAttackEngine()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local targets = {}
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in pairs(enemies:GetChildren()) do
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 and (char.HumanoidRootPart.Position - hrp.Position).Magnitude <= 65 then
                table.insert(targets, hrp)
            end
        end
    end

    if #targets > 0 then
        pcall(function()
            ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterAttack"):FireServer(0.001)
            for _, hit in pairs(targets) do
                ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterHit"):FireServer(hit, {})
            end
        end)
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped then equipped:Activate() end
    end
end

task.spawn(function()
    while true do
        if _G.Config.FastAttack then
            FastAttackEngine()
        end
        task.wait(_G.Config.AttackDelay)
    end
end)

-- Health Bar Engine (All 5 Styles Working)
local HealthGuis = {}

local function ClearAllHealthBars()
    for _, item in pairs(HealthGuis) do
        if item.Gui then item.Gui:Destroy() end
    end
    HealthGuis = {}
end

local function CreateHealthBar(plr)
    if plr == player or not _G.Config.HealthBarEnabled then return end

    local function ApplyGui(char)
        if not char then return end
        local head = char:WaitForChild("Head", 4)
        local humanoid = char:WaitForChild("Humanoid", 4)
        if not head or not humanoid then return end

        local bb = Instance.new("BillboardGui", ScreenGui)
        bb.Adornee = head
        bb.AlwaysOnTop = true
        bb.Size = UDim2.new(0, 120, 0, 20)
        bb.ExtentsOffset = Vector3.new(0, 2.5, 0)

        local bg = Instance.new("Frame", bb)
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 4)

        local fill = Instance.new("Frame", bg)
        fill.Name = "Fill"
        fill.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
        fill.BackgroundColor3 = Color3.fromRGB(0, 230, 100)
        Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 4)

        local label = Instance.new("TextLabel", bg)
        label.Name = "Label"
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 9
        label.Text = plr.DisplayName .. " [" .. math.floor(humanoid.Health) .. "]"

        HealthGuis[plr] = {Gui = bb, Fill = fill, Label = label, Hum = humanoid}
    end

    if plr.Character then ApplyGui(plr.Character) end
    table.insert(Connections, plr.CharacterAdded:Connect(ApplyGui))
end

function RefreshHealthBars()
    ClearAllHealthBars()
    if _G.Config.HealthBarEnabled then
        for _, p in pairs(Players:GetPlayers()) do CreateHealthBar(p) end
    end
end

table.insert(Connections, RunService.RenderStepped:Connect(function()
    if _G.Config.HealthBarEnabled then
        for plr, data in pairs(HealthGuis) do
            if data and data.Hum and data.Hum.Parent then
                local pct = math.clamp(data.Hum.Health / data.Hum.MaxHealth, 0, 1)
                data.Fill.Size = UDim2.new(pct, 0, 1, 0)
                data.Label.Text = plr.DisplayName .. " [" .. math.floor(data.Hum.Health) .. "]"
            end
        end
    end
end))

-- Live Radar Timers Engine (الوقت الحقيقي)
table.insert(Connections, RunService.Heartbeat:Connect(function()
    -- Elite Hunter Live Time
    local gameTime = workspace.DistributedGameTime
    local nextSpawnSecs = 600 - (gameTime % 600)
    local mins = math.floor(nextSpawnSecs / 60)
    local secs = math.floor(nextSpawnSecs % 60)
    
    local enemies = workspace:FindFirstChild("Enemies")
    local spawnedElite = false
    if enemies then
        for _, e in pairs({"Deandre", "Diablo", "Urban"}) do
            if enemies:FindFirstChild(e) then
                EliteLabel.Text = " Elite Hunter: Spawned NOW! (" .. e .. ")"
                spawnedElite = true
                break
            end
        end
    end
    if not spawnedElite then
        EliteLabel.Text = string.format(" Elite Hunter: Next Spawn in %02d:%02d", mins, secs)
    end

    -- Full Moon Real-Time
    local moonPhase = Lighting:GetAttribute("MoonPhase") or 0
    if moonPhase == 5 then
        FullMoonLabel.Text = " Full Moon: Active NOW!"
    else
        FullMoonLabel.Text = " Full Moon: Phase " .. tostring(moonPhase) .. "/5 (In Progress)"
    end
end))

