-- 2. Fast Attack المحسّن والشغال 100%
-- ==========================================

_G.FastAttack = false
_G.AttackSpeed = 0.01

local function ExecuteFastAttack()
    if not _G.FastAttack then return end
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        for _, mob in pairs(enemies:GetChildren()) do
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                if (char.HumanoidRootPart.Position - hrp.Position).Magnitude <= 65 then
                    pcall(function()
                        local net = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net")
                        net:WaitForChild("RE/RegisterAttack"):FireServer(0)
                        net:WaitForChild("RE/RegisterHit"):FireServer(hrp, {}, tostring(math.random(1000, 9999)))
                    end)
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then tool:Activate() end
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        if _G.FastAttack then
            ExecuteFastAttack()
        end
        task.wait(_G.AttackSpeed)
    end
end)

