local function ProcessFruitESP()
    for _, item in pairs(workspace:GetChildren()) do
        if item:IsA("Tool") and (item.Name:find("Fruit") or item:FindFirstChild("Handle")) then
            local handle = item:FindFirstChild("Handle") or item
            if _G.Config.FruitESP then
                if not handle:FindFirstChild("FruitESP_Tag") then
                    local bb = Instance.new("BillboardGui", handle)
                    bb.Name = "FruitESP_Tag"
                    bb.Size = UDim2.new(0, 120, 0, 30)
                    bb.AlwaysOnTop = true
                    bb.StudsOffset = Vector3.new(0, 3, 0)
                    
                    local txt = Instance.new("TextLabel", bb)
                    txt.Size = UDim2.new(1, 0, 1, 0)
                    txt.BackgroundTransparency = 1
                    txt.Text = "🍎 " .. item.Name
                    txt.TextColor3 = Color3.fromRGB(0, 255, 150)
                    txt.Font = Enum.Font.GothamBold
                    txt.TextSize = 10
                end
            else
                if handle:FindFirstChild("FruitESP_Tag") then
                    handle.FruitESP_Tag:Destroy()
                end
            end
            
            if _G.Config.AutoGrab and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = handle.CFrame
            end
        end
    end
end

